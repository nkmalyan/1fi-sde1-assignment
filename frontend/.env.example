# In local development this is left unset — Vite's dev-server proxy
# (see vite.config.js) forwards /api/* to http://localhost:4001 automatically.
#
# In production (e.g. deployed on Vercel), set this to your deployed
# backend's URL, e.g.:
# VITE_API_URL=https://your-backend.onrender.com/api
VITE_API_URL=
